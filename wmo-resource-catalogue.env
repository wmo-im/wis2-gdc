export WMO_RESOURCE_CATALOGUE_LOGGING_LEVEL=DEBUG
export WMO_RESOURCE_CATALOGUE_API_URL=http://localhost:8000
export WMO_RESOURCE_CATALOGUE_API_URL_DOCKER=http://wmo-resource-catalogue-api:8080
export WMO_RESOURCE_CATALOGUE_BACKEND_TYPE=Elasticsearch
export WMO_RESOURCE_CATALOGUE_BACKEND_CONNECTION=http://wmo-resource-catalogue-backend:9200/wis2-discovery-metadata
export WMO_RESOURCE_CATALOGUE_BROKER_URL=mqtt://wmo-resource-catalogue:wmo-resource-catalogue@wmo-resource-catalogue-broker:1883
export WMO_RESOURCE_CATALOGUE_CACHE_URL=redis://wmo-resource-catalogue-cache:6379
export WMO_RESOURCE_CATALOGUE_CACHE_RETENTION_SECONDS=3600
export WMO_RESOURCE_CATALOGUE_CENTRE_ID=ca-eccc-msc-global-discovery-catalogue
export WMO_RESOURCE_CATALOGUE_COLLECTOR_URL=http://wmo-resource-catalogue-metrics-collector:8006
export WMO_RESOURCE_CATALOGUE_GB=mqtts://everyone:everyone@globalbroker.meteo.fr:8883
#export WMO_RESOURCE_CATALOGUE_GB=${WMO_RESOURCE_CATALOGUE_BROKER_URL}
export WMO_RESOURCE_CATALOGUE_GB_TOPIC=cache/a/wis2/+/metadata
export WMO_RESOURCE_CATALOGUE_PUBLISH_REPORTS=true
export WMO_RESOURCE_CATALOGUE_REJECT_ON_FAILING_ETS=true
export WMO_RESOURCE_CATALOGUE_RUN_KPI=true
export WMO_RESOURCE_CATALOGUE_EXPERIMENTAL=false

# enable/disable WIS2 / WIGOS catalogues
export WMO_RESOURCE_WIS2_GDC_ENABLED=true
export WMO_RESOURCE_WIGOS_GSC_ENABLED=true

# WIS2 global broker links
export WMO_RESOURCE_CATALOGUE_GB_LINK_METEOFRANCE="fr-meteofrance-global-broker,mqtts://everyone:everyone@globalbroker.meteo.fr:8883,Météo-France, Global Broker Service"
export WMO_RESOURCE_CATALOGUE_GB_LINK_CMA="cn-cma-global-broker,mqtts://everyone:everyone@gb.wis.cma.cn:8883,China Meteorological Administration, Global Broker Service"
export WMO_RESOURCE_CATALOGUE_GB_LINK_NOAA="us-noaa-nws-global-broker,mqtts://everyone:everyone@wis2globalbroker.nws.noaa.gov:8883,National Oceanic and Atmospheric Administration, National Weather Service, Global Broker Service"
export WMO_RESOURCE_CATALOGUE_GB_LINK_INMET="br-inmet-global-broker,mqtts://everyone:everyone@globalbroker.inmet.gov.br:8883,Instituto Nacional de Meteorologia (Brazil), Global Broker Service"

